# AC-13: the survey's piece bytes plus directory overhead equal the scan's allocated bytes.
rule: parity (AC-13)
mutant: the survey skips the root's own blocks
note: interim killing test: the spec names the guard's parity invariant (d), and the guard is red at f64a075; lanes check_invariants asserts the same parity and runs green. Add the guard pair when it is enabled.
killing-test: lanes lane_backup_for_idle_loose_files
assertion: piece bytes plus dir overhead equal the scan's allocated bytes
--- a/crates/core/src/pieces.rs
+++ b/crates/core/src/pieces.rs
@@ -364,7 +364,7 @@
         let root_dev = md.dev;
         // The root's own blocks are counted as the main scan counts them: those of the directory
         // it names (a symlinked root's target), never the link object's (CT-A3).
-        let root_alloc = md.alloc;
+        let root_alloc = 0;
         let idx = t.dirs.len();
         t.dirs.push(DirRec {
             path: root.clone(),
