# AC-21, NEG-30: a secret-named entry inside an artifact stays its own keep piece; the artifact's item stays remove-regenerable.
rule: secret asks
mutant: an artifact holding a secret-named entry asks (note_entry records the entry as hard unique state)
killing-test: rescue artifact_secret
assertion: node_modules: item is Ask
--- a/crates/core/src/scan.rs
+++ b/crates/core/src/scan.rs
@@ -622,6 +622,9 @@
                     *slot = Some((name.to_string(), i));
                 }
             }
+            if self.state_hard.is_none() && rules.secret_file(name, true).is_some() {
+                self.state_hard = Some((name.to_string(), 0));
+            }
         }
     }
 }
